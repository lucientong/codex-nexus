<view class="container">
  <view class="logo">
    <!-- 测试Base64图片 -->
    <image 
      src="data:image/svg+xml;base64,"
      mode="aspectFit"
      binderror="handleImageError"
    ></image>
  </view>
  <view class="title">藏书云廊</view>
  <view class="subtitle">登录以使用完整功能</view>
  
  <button 
    class="login-btn {{loading ? 'loading' : ''}}"
    type="primary" 
    bindtap="handleLogin"
    loading="{{loading}}"
  >
    微信一键登录
  </button>
</view> 