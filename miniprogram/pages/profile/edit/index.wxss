.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  box-sizing: border-box;
}

.avatar-section {
  background-color: #fff;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  margin-bottom: 20rpx;
}

.upload-btn {
  width: 240rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #333;
  background: #f8f8f8;
  border: 1rpx solid #ddd;
  border-radius: 32rpx;
}

.form-group {
  background-color: #fff;
  padding: 0 40rpx;
  border-radius: 12rpx;
}

.form-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.submit-btn {
  margin: 60rpx 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #333;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
} 