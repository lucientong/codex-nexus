.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx;
  box-sizing: border-box;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.content {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.section-content {
  margin-bottom: 20rpx;
}

.list-item {
  margin-bottom: 16rpx;
  padding-left: 20rpx;
  position: relative;
}

.list-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  background-color: #333;
  border-radius: 50%;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #1f1f1f;
  }

  .content {
    background-color: #2c2c2c;
  }

  .title,
  .section-title,
  .section-content,
  .list-item {
    color: #fff;
  }

  .list-item::before {
    background-color: #fff;
  }
} 