.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx;
  box-sizing: border-box;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  padding: 40rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  border-radius: 40rpx;
  background-color: #000;
  padding: 20rpx;
  box-sizing: border-box;
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.version {
  font-size: 24rpx;
  color: #999;
}

/* 功能介绍 */
.feature-section {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
}

.feature-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.feature-info {
  flex: 1;
}

.feature-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 联系方式 */
.contact-section {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.contact-label {
  color: #666;
  margin-right: 10rpx;
}

.contact-value {
  color: #333;
}

/* 版权信息 */
.copyright {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 深色模式 */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #1f1f1f;
  }

  .feature-section,
  .contact-section {
    background-color: #2c2c2c;
  }

  .app-name,
  .section-title,
  .feature-name,
  .contact-value {
    color: #fff;
  }

  .version,
  .feature-desc,
  .contact-label,
  .copyright {
    color: #666;
  }
} 