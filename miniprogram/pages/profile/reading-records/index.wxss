.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.tab-bar {
  background-color: #fff;
  display: flex;
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 1;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  position: relative;
}

.tab-item.active {
  color: #333;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #333;
  border-radius: 2rpx;
}

.record-list {
  flex: 1;
  padding: 20rpx;
}

.record-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  position: relative;
}

.cover {
  width: 160rpx;
  height: 200rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.meta {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.type {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.date, .duration {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.progress-bar {
  width: 100%;
  height: 4rpx;
  background-color: #f0f0f0;
  border-radius: 2rpx;
  margin-bottom: 8rpx;
}

.progress {
  height: 100%;
  background-color: #52c41a;
  border-radius: 2rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.rating {
  display: flex;
  align-items: center;
}

.rating-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.stars {
  display: flex;
}

.star {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
  background-image: url('data:image/svg+xml;base64,');
  background-size: contain;
}

.star.active {
  background-image: url('data:image/svg+xml;base64,');
}

.actions {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
}

.action-btn {
  margin-left: 16rpx;
  font-size: 24rpx;
}

.action-btn.note {
  color: #333;
  background-color: #f8f8f8;
  border: 1rpx solid #ddd;
}

.loading, .no-more {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
}

/* 笔记弹窗 */
.note-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s;
}

.note-modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.note-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 20rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.note-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
} 