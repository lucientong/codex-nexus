.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.tab-bar {
  background-color: #fff;
  display: flex;
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 1;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  position: relative;
}

.tab-item.active {
  color: #333;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #333;
  border-radius: 2rpx;
}

.record-list {
  flex: 1;
  padding: 20rpx;
}

.record-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  position: relative;
}

.cover {
  width: 160rpx;
  height: 200rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.meta {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.type {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.status.pending {
  color: #faad14;
  background-color: #fff7e6;
}

.status.approved {
  color: #52c41a;
  background-color: #f6ffed;
}

.status.returned {
  color: #666;
  background-color: #f5f5f5;
}

.actions {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
}

.action-btn {
  margin-left: 16rpx;
  font-size: 24rpx;
}

.action-btn.return {
  color: #fff;
  background-color: #52c41a;
}

.loading, .no-more {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
} 