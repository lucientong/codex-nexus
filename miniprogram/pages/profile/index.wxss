.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0;
}

.user-info {
  width: 100%;
  background-color: #ffffff;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 30rpx;
}

.info {
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.id {
  font-size: 24rpx;
  color: #999;
}

.menu-list {
  margin-top: 20rpx;
  background-color: #ffffff;
  width: 100%;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 28rpx;
}

.logout-btn {
  margin: 60rpx 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #ff4d4f;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 32rpx;
} 