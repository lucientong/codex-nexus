.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0;
}

/* 顶部操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #fff;
}

.search-bar {
  flex: 1;
  position: relative;
  margin-right: 20rpx;
}

.search-input {
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  background-color: #333;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
}

/* 书房列表 */
.library-list {
  height: calc(100vh - 112rpx);
}

.library-item {
  margin: 20rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  display: flex;
  justify-content: space-between;
}

.library-info {
  flex: 1;
  margin-right: 20rpx;
}

.library-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.library-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.library-visibility {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.library-visibility.private {
  background-color: #f5f5f5;
  color: #666;
}

.library-visibility.friends {
  background-color: #e6f7ff;
  color: #1890ff;
}

.library-visibility.public {
  background-color: #f6ffed;
  color: #52c41a;
}

.library-description {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.library-stats {
  display: flex;
  gap: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.stat-value {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.library-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-item {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
}

.action-item.edit {
  background-color: #f0f0f0;
}

.action-item.delete {
  background-color: #fff1f0;
}

.action-icon {
  font-size: 32rpx;
}

/* 加载状态 */
.loading, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty text {
  font-size: 28rpx;
  color: #999;
} 