# 环境变量配置示例
# 复制此文件为 .env.development 或 .env.production 并填写实际值

# 云开发环境 ID（从腾讯云开发控制台获取）
TARO_APP_CLOUD_ENV=your-cloud-env-id

# 小程序 AppID（从微信公众平台获取）
TARO_APP_APPID=your-appid-here

# Discogs API 配置（用于 CD/黑胶数据查询，可选）
# 获取地址：https://www.discogs.com/developers
TARO_APP_DISCOGS_KEY=
TARO_APP_DISCOGS_SECRET=

# Google Books API 配置（用于图书数据查询，可选）
# 获取地址：https://console.cloud.google.com/
TARO_APP_GOOGLE_BOOKS_KEY=
